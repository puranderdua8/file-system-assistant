# API key that allows the application to successfully talk to a LLM.
# I have used Gemini API Key, but feel free to change to whatever LLM API Key you have.
# Update the same in it's usage.
# GEMINI_API_KEY={Paste API Key here} 
# Optional
# GEMINI_MODEL=gemini-flash-latest
# FS_ROOT=/path/to/allowed/folder   # the assistant's tools are confined to this directory (default: ./data)
